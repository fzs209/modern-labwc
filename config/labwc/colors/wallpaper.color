# ------------------
# General Settings
# ------------------
border.width: 1
border.color: #c0c9c1
padding.height: 4
corner.radius: 0
window.titlebar.padding.height: 2
window.titlebar.padding.width: 5
window.label.text.justify: center

# --------------------
# Buttons
# ---------------------
window.button.height: 22
window.button.width: 28
window.button.spacing: 0

# ---------------------
# Active Window
# ---------------------
window.active.title.bg.color: #f6fbf4
window.active.label.text.color: #171d19

# ----------------------
# Inactive Window
# ----------------------
window.inactive.title.bg.color: #f6fbf4
window.inactive.label.text.color: #171d19

# -----------------------
# Menu
# -----------------------
menu.items.bg.color: #f0f5ee
menu.items.text.color: #171d19
menu.items.active.bg.color: #acf2c9
#menu.items.active.bg.color: #dfe4de
menu.items.active.text.color: #171d19
menu.border.width: 1
menu.border.color: #c0c9c1
menu.separator.width: 1
menu.separator.padding.width: 6
menu.separator.padding.height: 3
menu.separator.color: #266a4a
menu.items.padding.x: 6
menu.items.padding.y: 4
menu.width.min: 140
menu.width.max: 300
menu.overlap.x: -4
menu.overlap.y: 0

# ----------------------------
# On-Screen Display (OSD)
# ----------------------------
osd.bg.color: #f0f5ee
osd.label.text.color: #266a4a
osd.border.width: 1
osd.border.color: #c0c9c1
osd.window-switcher.width: 800
osd.window-switcher.padding: 8
osd.window-switcher.item.padding.x: 12
osd.window-switcher.item.padding.y: 12
osd.window-switcher.item.active.border.width: 1
osd.window-switcher.preview.border.width: 2
osd.window-switcher.preview.border.color: #266a4a
osd.workspace-switcher.boxes.width: 150
osd.workspace-switcher.boxes.height: 40
osd.workspace-switcher.boxes.border.width: 1
snapping.overlay.edge.bg.color: #266a4a80
snapping.overlay.region.bg.color: #266a4a80
