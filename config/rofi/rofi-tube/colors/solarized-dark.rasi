* {
border: rgba(20, 59, 69, 1);
    background:     rgba(0, 43, 54, 0.75);
    background-alt: rgba(7, 54, 66, 0.60);
    foreground:     rgba(131, 148, 150, 1.0);
    selected:       rgba(42, 161, 152, 0.85);
    hover:          rgba(42, 161, 152, 0.20);
    active:         rgba(181, 137, 0, 1.0);
    urgent:         rgba(220, 50, 47, 1.0);
}