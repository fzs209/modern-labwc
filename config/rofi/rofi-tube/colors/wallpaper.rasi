///**** Rofi matugen color theme ****///

* {
    background: rgba(246, 251, 244, 0.75);
    background-alt: rgba(234, 239, 233, 0.60);
    foreground: rgba(23, 29, 25, 1.0);
    selected: rgba(38, 106, 74, 0.85);
    hover: rgba(38, 106, 74, 0.20);
    border: rgba(192, 201, 193, 1);
    active: rgba(60, 100, 114, 1.0);
    urgent: rgba(186, 26, 26, 1.0);
}
