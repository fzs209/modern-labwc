* {
border: rgba(225, 229, 223, 1);
    background:     rgba(244, 246, 243, 0.75);
    background-alt: rgba(233, 237, 230, 0.60);
    foreground:     rgba(74, 74, 74, 1.0);
    selected:       rgba(58, 107, 87, 0.85);
    hover:          rgba(58, 107, 87, 0.20);
    active:         rgba(58, 107, 87, 1.0);
    urgent:         rgba(214, 97, 97, 1.0);
}