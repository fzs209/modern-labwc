* {
border: rgba(26, 31, 36, 1);
    background:     rgba(0, 0, 0, 0.75);
    background-alt: rgba(16, 16, 16, 0.60);
    foreground:     rgba(255, 255, 255, 1.0);
    selected:       rgba(98, 174, 239, 0.85);
    hover:          rgba(98, 174, 239, 0.20);
    active:         rgba(152, 195, 121, 1.0);
    urgent:         rgba(224, 107, 116, 1.0);
}
