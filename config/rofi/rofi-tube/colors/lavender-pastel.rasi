* {
border: rgba(230, 231, 234, 1);
    background:     rgba(245, 245, 247, 0.75);
    background-alt: rgba(232, 232, 237, 0.60);
    foreground:     rgba(76, 76, 109, 1.0);
    selected:       rgba(149, 117, 205, 0.85);
    hover:          rgba(149, 117, 205, 0.20);
    active:         rgba(128, 203, 196, 1.0);
    urgent:         rgba(239, 154, 154, 1.0);
}