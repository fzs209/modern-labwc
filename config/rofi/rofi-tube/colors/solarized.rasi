* {
border: rgba(20, 59, 69, 1);
    background:     rgba(0, 43, 54, 0.75);
    background-alt: rgba(7, 54, 66, 0.60);
    foreground:     rgba(238, 232, 213, 1.0);
    selected:       rgba(38, 139, 210, 0.85);
    hover:          rgba(38, 139, 210, 0.20);
    active:         rgba(133, 153, 0, 1.0);
    urgent:         rgba(220, 50, 47, 1.0);
}
