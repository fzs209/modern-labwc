[global]
    monitor = 0
    follow = none
    width = 450
    height = (0,250)
    origin = "top-right"
    alignment = "left"
    vertical_alignment = "center"
    ellipsize = "middle"
    offset = (30,30)
    padding = 16
    horizontal_padding = 16
    text_icon_padding = 16
    icon_position = "left"
    min_icon_size = 32
    max_icon_size = 96
    icon_corner_radius=8
    progress_bar = true
    progress_bar_height = 7
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_corner_radius = 2
    progress_bar_corners = all
    progress_bar_max_width = 450
    separator_height = 2
    frame_width = 0
    frame_color = "#c0c9c1"
    separator_color = "#266a4a"
    corner_radius = 14
    gap_size = 10
    line_height = 4
    notification_limit = 0
    idle_threshold = 0
    history_length = 20
    show_age_threshold = 60
    markup = "full"
    font = "Inter 13px"
    format = "<b>%s</b>\n%b"
    word_wrap = "yes"
    sort = "yes"
    shrink = "no"
    indicate_hidden = "yes"
    sticky_history = "no"
    ignore_newline = "no"
    show_indicators = "no"
    stack_duplicates = true
    always_run_script = true
    hide_duplicate_count = false
    ignore_dbusclose = false
    force_xwayland = false
    force_xinerama = false
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_all
    mouse_right_click = do_action

[experimental]
    per_monitor_dpi = false

[urgency_low]
    timeout = 3
    background = "#eaefe9"
    foreground = "#171d19"
    highlight = "#266a4a"
[urgency_normal]
    timeout = 6
    background = "#eaefe9"
    foreground = "#171d19"
    highlight = "#266a4a"
[urgency_critical]
    timeout = 0
    background = "#eaefe9"
    foreground = "#171d19"
    highlight = "#266a4a"


